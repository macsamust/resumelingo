{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "resumelingo",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Serves the built React app (client/dist) directly from Cloudflare's edge.
  // Static files are matched first; anything under /api/* always hits the
  // Worker (see run_worker_first), and anything else that doesn't match a
  // real file falls back to index.html for client-side routing.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": false
  },

  // Created via `npm run db:create` — copy the database_id it prints into
  // the entry below (it is NOT the same as database_name).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resumelingo-db",
      "database_id": "3de7d879-30be-4dbb-a593-74dc3d7291de",
      "migrations_dir": "migrations"
    }
  ],

  // Workers AI — used by ResumeImportService to turn an uploaded resume's
  // raw text into structured fields (see services/ResumeImportService.ts).
  // No API key needed; billed through this Cloudflare account. Runs against
  // the real Workers AI service even under `wrangler dev` (not locally
  // emulated), so it needs network access and will incur normal Workers AI
  // usage even in local dev.
  "ai": {
    "binding": "AI"
  },

  // Drives the weekly re-engagement view digest (ViewDigestService, invoked
  // from index.ts's `scheduled` export) — this is the app's first-ever
  // background job. "0 14 * * 1" is every Monday at 14:00 UTC (~9-10am US
  // Eastern depending on DST). Cron Triggers only take effect once deployed
  // (`wrangler deploy`); `wrangler dev` does not fire them automatically —
  // see the "Local dev" note in the deploy docs.
  "triggers": {
    "crons": ["0 14 * * 1"]
  },

  // Non-secret config. JWT_SECRET and RESEND_API_KEY are intentionally NOT
  // here — set them with `npm run secret:jwt` / `npm run secret:resend-key`
  // so they're encrypted rather than committed to git.
  "vars": {
    "CLIENT_ORIGIN": "https://resumelingo.legumes-postage-9k.workers.dev",
    // The "from" address for every transactional email (password reset,
    // email verification, the weekly view digest). resumelingo.com is now a
    // Resend-verified sending domain (DKIM/SPF/MX all confirmed, Aug 2026) —
    // this was previously stuck on Resend's shared onboarding@resend.dev
    // sandbox address, which silently refuses to deliver to any recipient
    // other than the Resend account's own email. Not secret — update this
    // directly if the sending domain ever changes.
    "RESEND_FROM_EMAIL": "ResumeLingo <noreply@resumelingo.com>"
  }
}
