PORT=4000
JWT_SECRET=change-this-secret-in-production

# Postgres connection string. For Render Postgres, use the "External
# Database URL" shown on your database's dashboard page (the "Internal
# Database URL" only works from other services inside the same Render
# region/private network, which is fine too if your web service lives there).
# For local dev, point this at a local Postgres instance, e.g.:
#   postgresql://postgres:postgres@localhost:5432/websume
DATABASE_URL=postgresql://user:password@localhost:5432/websume

CLIENT_ORIGIN=http://localhost:5173
