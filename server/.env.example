PORT=4000
JWT_SECRET=change-this-secret-in-production

# Postgres connection string. For Render Postgres, use the "External
# Database URL" shown on your database's dashboard page (the "Internal
# Database URL" only works from other services inside the same Render
# region/private network, which is fine too if your web service lives there).
# For local dev, point this at a local Postgres instance, e.g.:
#   postgresql://postgres:postgres@localhost:5432/resumelingo
DATABASE_URL=postgresql://user:password@localhost:5432/resumelingo

CLIENT_ORIGIN=http://localhost:5173
# CLIENT_ORIGIN=https://resumelingo.legumes-postage-9k.workers.dev

# Stripe (subscription billing). Get these from the Stripe Dashboard:
# - STRIPE_SECRET_KEY: Developers > API keys (use a test-mode key while developing).
# - STRIPE_WEBHOOK_SECRET: Developers > Webhooks > your endpoint > "Signing secret"
#   (or run `stripe listen --forward-to localhost:4000/api/webhooks/stripe` locally,
#   which prints a temporary whsec_... secret for you to use here).
# - STRIPE_PRICE_PROFESSIONAL / STRIPE_PRICE_PREMIUM: the Price IDs (price_...) for
#   the $9.99/mo and $19.99/mo recurring Prices you create under Products in Stripe.
#   The Starter tier is free and has no Stripe price.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_PREMIUM=price_...

# Admin dashboard (separate login from regular users — see services/AdminService.ts).
# Set these once to create the first admin account automatically at boot;
# after that, admins are managed by whoever already has admin access (there's
# no self-registration). Safe to remove from your env after the first boot.
ADMIN_EMAIL=admin@resumelingo.app
ADMIN_PASSWORD=change-this-password
# Optional — defaults to JWT_SECRET if unset. Setting a distinct secret keeps
# admin tokens cryptographically separate from regular user tokens.
ADMIN_JWT_SECRET=change-this-secret-too

# Password reset email (see services/EmailService.ts, AuthService.requestPasswordReset).
# Sign up at https://resend.com, then either:
# - verify your own sending domain (Domains > Add Domain) and set
#   RESEND_FROM_EMAIL to an address on it, e.g. "ResumeLingo <noreply@yourdomain.com>"; or
# - for quick testing before you've verified a domain, use Resend's shared
#   sandbox sender below — it only delivers to the email address on your own
#   Resend account, so it's fine for testing but not for real users.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=ResumeLingo <onboarding@resend.dev>
